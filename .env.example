# Postgres connection string, e.g. from Supabase, Neon, or your own instance.
# Use the pooled connection string if your provider offers one (Neon, Supabase).
DATABASE_URL="postgresql://user:password@localhost:5432/theutest"
# Direct (non-pooled) connection, used only for running migrations.
# On Neon this is the connection string WITHOUT "-pooler" in the hostname.
DIRECT_URL="postgresql://user:password@localhost:5432/theutest"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Stripe API keys — https://dashboard.stripe.com/apikeys
# Deliberately NOT prefixed with NEXT_PUBLIC_ — it's read server-side in
# app/checkout/page.tsx and passed down as a prop, which avoids Vercel's
# dashboard flagging it as a "this will be public" warning on save. It's
# still a publishable key, so it ending up in the browser bundle is fine.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# Stripe webhook signing secret — https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
