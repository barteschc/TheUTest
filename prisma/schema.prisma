generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  bundleActive Boolean  @default(false)
  createdAt    DateTime @default(now())

  results   QuizResult[]
  purchases Purchase[]
}

// One row per test a user has taken. Answers are stored so trait
// scores and the free/paid report content can be recomputed deterministically.
model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId    String
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, testId])
}

enum PurchaseType {
  single
  bundle
}

enum PurchaseStatus {
  pending
  succeeded
}

model Purchase {
  id                     String         @id @default(cuid())
  userId                 String
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                   PurchaseType
  testId                 String? // null when type is "bundle"
  amountCents            Int
  stripePaymentIntentId  String         @unique
  status                 PurchaseStatus @default(pending)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([userId])
}
